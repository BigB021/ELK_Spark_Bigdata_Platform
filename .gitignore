# =============================================================================
#  Only sources are versioned. Everything below is regenerated by running the
#  platform (docker compose up -d) and the scripts in scripts/.
# =============================================================================

# --- Run outputs (recreated by Logstash / Spark) ------------------------------
logstash/output/*
!logstash/output/.gitkeep
spark/output/*
!spark/output/.gitkeep

# --- TP4 submission folder: copies of repo files + generated captures/PDF -----
# Kept: the index and the hand-written report source.
# Rebuild: scripts/collect_evidence.py, scripts/capture_screenshots.py,
#          scripts/render_report_pdf.py (see README "Livrables TP4")
TP2_ELK_Spark_NomBinome/*
!TP2_ELK_Spark_NomBinome/README.md
!TP2_ELK_Spark_NomBinome/5_rapport/
TP2_ELK_Spark_NomBinome/5_rapport/*
!TP2_ELK_Spark_NomBinome/5_rapport/rapport_source.html

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Local / editor / OS noise -----------------------------------------------
logs/
*.log
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Stray local files (duplicates / accidental) ------------------------------
docs/datasets/
/262144
