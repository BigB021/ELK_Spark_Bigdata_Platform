# ---------------------------------------------------------------------------
# Versions & sizing of the ELK + Spark platform (TP3 / TP4)
# All Elastic components MUST share the same version.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ed-bigdata

STACK_VERSION=8.17.4
SPARK_IMAGE=spark:3.5.5-scala2.12-java17-python3-ubuntu
ES_SPARK_CONNECTOR=org.elasticsearch:elasticsearch-spark-30_2.12:8.17.4
CURL_IMAGE=curlimages/curl:8.11.1

CLUSTER_NAME=ed-analytics-cluster

# JVM heaps (keep heap <= 50% of the container memory limit)
ES_HEAP=512m
LS_HEAP=512m

# Container memory limits
ES_MEM_LIMIT=1g
KB_MEM_LIMIT=1g
LS_MEM_LIMIT=1g
SPARK_MASTER_MEM_LIMIT=1536m
SPARK_WORKER_MEM_LIMIT=1536m

# Spark worker resources
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g
